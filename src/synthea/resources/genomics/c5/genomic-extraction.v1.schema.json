{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiet.ai/schemas/extraction/genomic/v1",
  "type": "object",
  "required": [
    "schema",
    "document_sha256",
    "source_text",
    "source_text_sha256",
    "entities",
    "needs_review",
    "extractor_version"
  ],
  "$defs": {
    "validation": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "schema": {
          "const": "tietai.variant-validation/v1"
        },
        "status": {
          "enum": [
            "valid",
            "invalid",
            "unresolved"
          ]
        },
        "canonical": {
          "type": "object",
          "properties": {
            "g": {
              "type": "string"
            },
            "c": {
              "type": "string"
            },
            "p": {
              "type": "string"
            },
            "genome_build": {
              "type": "string"
            }
          }
        },
        "vrs_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "normalised": {
          "type": "boolean"
        },
        "gene": {
          "type": "object",
          "properties": {
            "hgnc_id": {
              "type": "string",
              "pattern": "^HGNC:\\d+$"
            },
            "symbol": {
              "type": "string"
            }
          }
        },
        "sequence_ontology": {
          "type": "string"
        },
        "message_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "tietai.genomic-extraction/v1"
    },
    "entities": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "https://tiet.ai/schemas/extraction/clinical/v1#/$defs/entity"
          },
          {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "specimen",
                  "assay",
                  "variant",
                  "implication",
                  "tmb",
                  "msi",
                  "knowledge_release",
                  "recommendation"
                ]
              },
              "rejected": {
                "type": "boolean"
              },
              "reviewer_rejected": {
                "type": "boolean"
              },
              "review_flags": {
                "type": "array",
                "items": {
                  "enum": [
                    "HGVS_INVALID",
                    "HGVS_UNRESOLVED",
                    "HGVS_MISSING",
                    "SCHEMA_VIOLATION",
                    "IMPLICATION_UNLINKED",
                    "SOURCE_CLASS_UNKNOWN",
                    "CLASSIFICATION_UNKNOWN",
                    "GENE_UNRESOLVED",
                    "FIELD_NOT_IN_QUOTE",
                    "SPECIMEN_UNRESOLVED",
                    "ASSERTION_NOT_PRESENT",
                    "ASSERTION_CUE",
                    "ASSERTION_UNSTATED",
                    "ENUM_NOT_IN_QUOTE",
                    "HGVS_COMPOSED"
                  ]
                }
              },
              "specimen_identifier": {
                "type": "string"
              },
              "specimen_type": {
                "type": "string"
              },
              "collected_on": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "panel_name": {
                "type": "string"
              },
              "panel_version": {
                "type": "string"
              },
              "lab": {
                "type": "string"
              },
              "build": {
                "enum": [
                  "GRCh37",
                  "GRCh38",
                  "T2T-CHM13",
                  "unknown"
                ]
              },
              "gene": {
                "type": "string",
                "pattern": "^[A-Z0-9][A-Z0-9-]{0,19}$"
              },
              "hgvs_c": {
                "type": "string"
              },
              "hgvs_p": {
                "type": "string"
              },
              "hgvs_g": {
                "type": "string"
              },
              "vaf": {
                "type": "string",
                "pattern": "^\\d{1,3}([.,]\\d+)?%?$"
              },
              "zygosity": {
                "enum": [
                  "heterozygous",
                  "homozygous",
                  "hemizygous",
                  "mosaic",
                  "unknown"
                ]
              },
              "source_class": {
                "enum": [
                  "germline",
                  "somatic",
                  "fetal",
                  "likely_germline",
                  "likely_somatic",
                  "unknown"
                ]
              },
              "classification": {
                "enum": [
                  "pathogenic",
                  "likely_pathogenic",
                  "vus",
                  "likely_benign",
                  "benign",
                  "tier_i",
                  "tier_ii",
                  "tier_iii",
                  "tier_iv",
                  "oncogenic",
                  "likely_oncogenic",
                  "unknown"
                ]
              },
              "classification_system": {
                "enum": [
                  "ACMG",
                  "AMP",
                  "ClinGen",
                  "lab",
                  "unknown"
                ]
              },
              "specimen_entity_id": {
                "type": "string",
                "pattern": "^ent_\\d{4}$"
              },
              "unsupported_fields": {
                "type": "array",
                "items": {
                  "enum": [
                    "classification",
                    "source_class",
                    "zygosity",
                    "classification_system"
                  ]
                }
              },
              "validation": {
                "$ref": "#/$defs/validation"
              },
              "implication_kind": {
                "enum": [
                  "diagnostic",
                  "therapeutic",
                  "prognostic"
                ]
              },
              "evidence_level": {
                "type": "string"
              },
              "phenotype": {
                "type": "string"
              },
              "linked_variant_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^ent_\\d{4}$"
                }
              },
              "therapy": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "name": {
                "enum": [
                  "clinvar",
                  "hgnc",
                  "cosmic",
                  "oncokb",
                  "civic",
                  "lab",
                  "other"
                ]
              },
              "version": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "implication"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "required": [
                    "quote",
                    "implication_kind",
                    "linked_variant_ids"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "knowledge_release"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "required": [
                    "quote",
                    "name",
                    "version"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "variant",
                        "specimen",
                        "assay",
                        "tmb",
                        "msi",
                        "recommendation"
                      ]
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "required": [
                    "quote"
                  ]
                }
              }
            ]
          }
        ],
        "unevaluatedProperties": false
      }
    },
    "rejected": {
      "type": "array"
    },
    "review_flags": {
      "type": "array"
    },
    "needs_review": {
      "const": true
    }
  },
  "$comment": "Copied from TIET-AI/tietai-hydra-platform pkg/clinicalextract/schemas/genomic_v1.yaml at origin/feat/GO-22 91e8fbff59c676d0e2c766ca375e290758166c2c (GO-13 PR #1399 @ 39fc621b8be06a6ea70bc0135e3fa0f740e7c3ce, GO-22 PR #1401). Contract C5; owners GO-13/GO-22. Re-sync after those PRs merge."
}
